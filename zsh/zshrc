# downloadinux — shell config
# Live-mounted from ./zsh/zshrc in the repo. Edit on the host, `exec zsh`
# in the container to reload. No rebuild needed.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="af-magic"

plugins=(
  git
  colored-man-pages
  command-not-found
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

# --- History lives on a named volume so it survives rebuilds ---------------
HISTFILE="$HOME/.local/share/downloadinux/zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY INC_APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_ALL_DUPS

# --- PATH: the downloader venv wins ----------------------------------------
export PATH="/opt/venv/bin:$PATH"
export EDITOR="nano"

# --- Custom aliases & functions (also live-mounted) ------------------------
for _f in "$HOME"/.zsh-custom/*.zsh(N); do
  source "$_f"
done
unset _f

cd "$HOME/Downloads" 2>/dev/null || true
