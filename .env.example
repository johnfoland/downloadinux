# Don't edit this file — run `just env` to generate .env from it with your
# real UID/GID filled in, then `just token <token>` for the NordVPN part.

# --- Host identity ----------------------------------------------------------
# Match your host user so files in the shared ~/Downloads come back owned by you.
#   macOS/Linux:  id -u   /   id -g
PUID=1000
PGID=1000
USERNAME=dl

TZ=America/New_York

# --- Shared volume ----------------------------------------------------------
# Defaults to $HOME/Downloads. Point elsewhere (an external drive, say) here.
#HOST_DOWNLOADS=/Users/john/Downloads

# --- NordVPN ----------------------------------------------------------------
# Set this with `just token <token>` rather than by hand.
# To get one: https://my.nordaccount.com > Services > NordVPN > Manual setup >
# Set up NordVPN manually > Access token > Generate new token.
# Nord shows it exactly once. This is a credential; .env is gitignored.
NORDVPN_TOKEN=

# Connect automatically on container start
NORDVPN_AUTOCONNECT=false

# Where to connect. Passed straight to `nordvpn connect`, so it takes any of:
#   (empty)      Nord picks the fastest server for you
#   us           country code
#   United_States / Japan          country name
#   New_York     city name (underscores, not spaces)
#   us8649       a specific server number
#   p2p          a server group
# Pick a specific server with:  just vpn servers New_York
NORDVPN_SERVER=

# openvpn | nordlynx
# nordlynx (WireGuard) needs a kernel module that Docker Desktop's Linux VM
# does not ship, so openvpn is the default that actually works on macOS.
NORDVPN_TECHNOLOGY=openvpn

# on | off — blocks ALL traffic whenever the tunnel is down, including when it
# was never up. Nothing leaks, but the container has no internet at all until
# it connects, so turn NORDVPN_AUTOCONNECT on alongside it or the box boots
# dead. Blocked traffic hangs rather than erroring: yt-dlp will sit through its
# full retry schedule instead of failing fast.
NORDVPN_KILLSWITCH=off
